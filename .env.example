# Frontend build-time config (Vite). Set these as Environment Variables in
# the Vercel project dashboard — Vite bakes them into the built JS at build
# time, so they must be set BEFORE each deploy, not just at runtime.
# Values come from Firebase Console > Project Settings > General > Your apps.
# These are safe to expose client-side; that's how Firebase web apps work —
# access is controlled by firestore.rules, not by hiding these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
