# Set these as Variables on the Railway service running this backend
# (Service > Variables tab), not in a committed file.

# ── Razorpay ──────────────────────────────────────────────
# From dashboard.razorpay.com > Settings > API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
# From dashboard.razorpay.com > Settings > Webhooks, after creating a webhook
# pointed at https://<your-backend-domain>/api/payment/webhook. The webhook
# route intentionally fails closed (500s every event) if this is unset, so
# don't skip it.
RAZORPAY_WEBHOOK_SECRET=

# ── Server ────────────────────────────────────────────────
NODE_ENV=production
PORT=5001
# The deployed frontend origin (Vercel production URL / mjshoes.xyz).
# CORS rejects every other origin.
FRONTEND_URL=https://mjshoes.xyz
SITE_URL=https://mjshoes.xyz
# Proxy hops in front of the API (Vercel rewrite + Railway edge = 2). Rate
# limits key on the client IP behind these; leave unset to use the default.
# TRUST_PROXY_HOPS=2

# ── Redis ─────────────────────────────────────────────────
# Add the Redis plugin in Railway and it injects this automatically —
# usually no need to set it by hand.
REDIS_URL=

# ── Firebase Admin SDK ────────────────────────────────────
# Railway has no persistent filesystem for secret files, so paste the full
# contents of server/firebase-service-account.json here as one line (this is
# only used in production; locally GOOGLE_APPLICATION_CREDENTIALS + the JSON
# file still work as before — see firebase-admin.js).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=mjshoes-657b7
# Product photos are stored in Firestore (product_images), so no Storage
# bucket / Blaze plan is needed.

# ── Outbound email (order confirmations, payment-failure notices) ─────────
# Without these, production silently falls back to a throwaway Ethereal test
# inbox and customers never get emailed — env-check.js logs this loudly on
# boot if missing. Any SMTP provider works (SendGrid, Mailgun, Amazon SES,
# even a Gmail app password for low volume).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MJ Shoes" <noreply@mjshoes.xyz>

# ── Optional ──────────────────────────────────────────────
LOG_LEVEL=info
ALERT_WEBHOOK_URL=
GCS_BUCKET=
GCS_BACKUP_URI=
